# DREGG_HOSTNAME is supplied to the Caddy systemd unit from
# /etc/dregg/public.env. For the zero-cost bootstrap it can be an IP-derived
# hostname such as 203.0.113.10.sslip.io.

(strip_upstream_cors) {
    header_down -Access-Control-Allow-Origin
    header_down -Access-Control-Allow-Methods
    header_down -Access-Control-Allow-Headers
}

{$DREGG_HOSTNAME} {
    encode zstd gzip

    # Browser preflight for the deliberately small public membership surface.
    @preflight {
        method OPTIONS
        path /api/castalia/memberships /api/cell/* /status
    }
    handle @preflight {
        header Access-Control-Allow-Origin "*"
        header Access-Control-Allow-Methods "GET, POST, OPTIONS"
        header Access-Control-Allow-Headers "Content-Type"
        header Access-Control-Max-Age "600"
        respond "" 204
    }

    handle /api/castalia/memberships {
        reverse_proxy 127.0.0.1:8420 {
            import strip_upstream_cors
        }
    }

    handle /api/cell/* {
        reverse_proxy 127.0.0.1:8420 {
            import strip_upstream_cors
        }
    }

    handle /status {
        reverse_proxy 127.0.0.1:8420 {
            import strip_upstream_cors
        }
    }

    # Everything else stays private until it is intentionally reviewed.
    handle {
        respond "Not found" 404
    }

    header Access-Control-Allow-Origin "*"
    header Access-Control-Allow-Methods "GET, POST, OPTIONS"
    header Access-Control-Allow-Headers "Content-Type"
    header X-Content-Type-Options "nosniff"
    header X-Frame-Options "DENY"
    header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
    header Referrer-Policy "no-referrer"
    header Strict-Transport-Security "max-age=31536000; includeSubDomains"

    log {
        output file /var/log/caddy/dregg-access.log {
            roll_size 10MiB
            roll_keep 5
            roll_keep_for 168h
        }
        format json
    }
}
